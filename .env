# ========================================================
# AG CLOUD HOSTING - ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND / PUBLIC VARIABLES (VITE_*)
# Put these in Netlify Build & Deploy -> Environment variables
# --------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --------------------------------------------------------
# 2. BACKEND / PRIVATE SECRETS (NEVER EXPOSE IN FRONTEND)
# Put these strictly in Netlify Environment variables / local .env
# --------------------------------------------------------

# SUPABASE SERVICE ROLE KEY (Bypasses RLS for secure backend operations)
