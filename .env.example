# ========================================================
# NOVEXHOST - Environment Configuration Guide
# Brand: NOVEXHOST (Premium Cloud & VPS Hosting)
# ========================================================

# 1. Razorpay Payment Gateway (Test or Live Mode)
# Obtain from Razorpay Dashboard > Settings > API Keys:
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook Secret from Razorpay Dashboard > Settings > Webhooks (Endpoint: /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 2. Pterodactyl Panel Integration
# Application API Key created at: https://your-panel.com/admin/api
PTERODACTYL_PANEL_URL=https://panel.novexhost.com
PTERODACTYL_APPLICATION_API_KEY=ptla_your_application_key
PTERODACTYL_CLIENT_API_KEY=ptlc_your_client_key
PTERODACTYL_NODE_ID=1
PTERODACTYL_LOCATION_ID=1
PTERODACTYL_NEST_ID=1
PTERODACTYL_MINECRAFT_EGG_ID=3

# 3. SMTP Email Notifications (Aqua-themed HTML receipts & deployment alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@novexhost.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="NOVEXHOST Support <notifications@novexhost.com>"

# 4. Public Web URL (For tracking links in customer emails)
PUBLIC_URL=http://localhost:3000

# 5. Firebase Admin Authentication (For secure Admin Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
FIREBASE_PROJECT_ID=your_project_id

# 6. Admin Access Emails (Comma-separated)
ADMIN_EMAILS=admin@novexhost.com,notxlaksly@gmail.com,r26377269@gmail.com

# 7. Supabase Database (Optional for remote PostgreSQL sync)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 8. cPanel / WHM Web Hosting API Integration
# Create an API token in WHM: Manage API Tokens > Generate Token
WHM_HOST=https://cpanel.novexhost.com
WHM_USERNAME=root
WHM_API_TOKEN=your_whm_api_token
WHM_PORT=2087

# 9. VDS Physical Bare-Metal Infrastructure (NOC / BMC / Redfish)
REDFISH_API_ENABLED=false
DEFAULT_BAREMETAL_LOCATION="Mumbai DC-1 (Equinix MBX)"
CLOUDFLARE_MAGIC_TRANSIT_ENABLED=true
