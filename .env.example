# ==============================================================================
# NOVEXHOST — Complete Production & Development Environment Configuration Template
# Brand: NOVEXHOST | Premium Web Hosting & Bare-Metal VDS Cloud Platform
# ==============================================================================
# NOTE: Copy this file to '.env' for local development.
# NEVER commit your real '.env' file or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment: development or production
NODE_ENV=development
# Canonical public base URL (used to generate customer order tracking links in emails)
PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Safe for browser / Vite build)
# ------------------------------------------------------------------------------
# Backend API Base URL (leave empty if frontend and backend share the same domain)
VITE_API_BASE_URL=

# Firebase Client Configuration (used for Admin login console authentication)
# Obtain from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-ABC123DEF4

# Supabase Client Configuration (Optional - for client-side queries with RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_public_key_here

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard > Settings > API Keys:
# https://dashboard.razorpay.com/app/keys
# Test Mode: rzp_test_... | Live Mode: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Webhook Secret from Razorpay Dashboard > Settings > Webhooks
# Set Webhook URL to: https://yourdomain.com/api/payments/webhook
# Active Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. PTERODACTYL PANEL INTEGRATION (Game Servers & Cloud VPS)
# ------------------------------------------------------------------------------
# Panel URL where Pterodactyl API is reachable
PTERODACTYL_PANEL_URL=https://panel.novexhost.com

# Application API Key created at: Admin > Application API (read/write servers, users, allocations)
PTERODACTYL_APPLICATION_API_KEY=ptla_your_application_key_here

# Client API Key created at: Account > API Credentials (server power, files, console)
PTERODACTYL_CLIENT_API_KEY=ptlc_your_client_key_here

# Target infrastructure identifiers in Pterodactyl
PTERODACTYL_NODE_ID=1
PTERODACTYL_LOCATION_ID=1
PTERODACTYL_NEST_ID=1
PTERODACTYL_MINECRAFT_EGG_ID=3

# ------------------------------------------------------------------------------
# 5. CPANEL / WHM API INTEGRATION (Web Hosting Provisioning)
# ------------------------------------------------------------------------------
# Hostname or IP of the WHM server
WHM_HOST=https://cpanel.novexhost.com
WHM_USERNAME=root
# Generated from WHM > Development > Manage API Tokens > Generate Token
WHM_API_TOKEN=your_whm_api_token_here
WHM_PORT=2087

# ------------------------------------------------------------------------------
# 6. VDS PHYSICAL BARE-METAL SERVERS (NOC / BMC / IPMI)
# ------------------------------------------------------------------------------
# CRITICAL: Keep false until physical datacenter hardware, IPMI controller IPs, and network drops are verified!
BARE_METAL_AUTO_PROVISION=false
DEFAULT_DATACENTER="Equinix Mumbai (BOM1)"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL DELIVERY (SMTP / Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@novexhost.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="NOVEXHOST Support <notifications@novexhost.com>"

# ------------------------------------------------------------------------------
# 8. DATABASE & BACKEND PERSISTENCE (Supabase PostgreSQL - Optional)
# ------------------------------------------------------------------------------
# Backend administrative connection with service_role privileges
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 9. PLATFORM ADMINISTRATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Comma-separated list of emails authorized for the /admin dashboard
ADMIN_EMAILS=admin@novexhost.com,r26377269@gmail.com,notxlaksly@gmail.com
